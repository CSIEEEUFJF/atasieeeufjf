# Banco de runtime: use uma URL poolada/transacional para evitar excesso de conexões na Vercel.
APP_DATABASE_URL="postgresql://APP_USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
POSTGRES_URL=""
DATABASE_POOL_MAX="1"

# Banco de migração/build: pode usar URL direta com usuário de migração.
PRISMA_DATABASE_URL="postgresql://MIGRATION_USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
DATABASE_URL=""
PDF_FORWARD_URL="https://save.ieeeufjf.com.br/atas/pdf"
PDF_FORWARD_TOKEN="troque-por-um-token-forte"
PDF_FORWARD_TOKEN_TTL_SECONDS="300"
ATA_RECEIVER_PORT="3001"
ATA_RECEIVER_TOKEN="mesmo-token-forte-do-forward"
ATA_RECEIVER_DATA_DIR="./atas-recebidas"
ATA_RECEIVER_MAX_PDF_BYTES="26214400"
ATA_RECEIVER_CORS_ORIGIN="https://interno.ieeeufjf.com.br"

# Sincronização opcional com o Firebase usado pelo AppRamo.
# Use uma service account do Firebase Admin SDK. Você pode informar o JSON inteiro
# em FIREBASE_SERVICE_ACCOUNT_JSON ou o caminho para o arquivo em FIREBASE_SERVICE_ACCOUNT_PATH.
FIREBASE_PROJECT_ID=""
FIREBASE_SERVICE_ACCOUNT_PATH=""
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Notificações por e-mail com Resend. Em produção, defina como true.
EMAIL_NOTIFICATIONS_ENABLED="false"
RESEND_API_KEY=""
EMAIL_FROM="Sistema Interno IEEE UFJF <noreply@ieeeufjf.com.br>"
SITE_INTEREST_RECIPIENT="ramo.ieeeufjf@gmail.com"
SITE_INTEREST_API_TOKEN=""

# Armazenamento interno de arquivos por usuário.
# Em produção, o modo padrão é "remote": exige o serviço Docker de dados.
# Use INTERNAL_FILES_STORAGE_MODE="local" apenas para desenvolvimento local.
INTERNAL_FILES_STORAGE_MODE="disabled"
INTERNAL_STORAGE_RECEIVER_URL="https://storage.interno.ieeeufjf.com.br"
INTERNAL_STORAGE_RECEIVER_TOKEN=""
INTERNAL_STORAGE_RECEIVER_TIMEOUT_MS="5000"
INTERNAL_STORAGE_DIR="./.data/internal-storage"
INTERNAL_STORAGE_MAX_BYTES="52428800"
