generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               Int           @id @default(autoincrement())
  name             String
  cargo            String        @default("")
  chapterRoles     Json          @default("{}") @map("chapter_roles")
  username         String        @unique
  email            String        @unique
  passwordHash     String        @map("password_hash")
  passwordSalt     String        @map("password_salt")
  failedLoginCount Int           @default(0) @map("failed_login_count")
  lockedUntil      DateTime?     @map("locked_until")
  isAdmin          Boolean       @default(false) @map("is_admin")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  atas             Ata[]
  assignedTasks    InternalTask[]  @relation("InternalTaskAssignee")
  createdEvents    InternalEvent[] @relation("InternalEventCreator")
  createdTasks     InternalTask[]  @relation("InternalTaskCreator")
  chapters         UserChapter[]
  memberContact    MemberContact?
  internalFiles     InternalFile[]  @relation("InternalFileOwner")
  sessions         Session[]

  @@map("users")
}

model Session {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @map("last_seen_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt], map: "idx_sessions_expires_at")
  @@index([tokenHash], map: "idx_sessions_token_hash")
  @@map("sessions")
}

model UserChapter {
  userId     Int      @map("user_id")
  chapterKey String   @map("chapter_key")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, chapterKey])
  @@index([chapterKey], map: "idx_user_chapters_chapter")
  @@map("user_chapters")
}

model SiteMember {
  id             Int      @id @default(autoincrement())
  name           String
  role           String   @default("Membro")
  chapters       Json     @default("[]")
  bio            String   @default("")
  photoUrl       String   @default("") @map("photo_url")
  photoPositionX Int      @default(50) @map("photo_position_x")
  photoPositionY Int      @default(50) @map("photo_position_y")
  photoZoom      Int      @default(100) @map("photo_zoom")
  isPublic       Boolean  @default(true) @map("is_public")
  position       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([isPublic, position, name], map: "idx_site_members_public_order")
  @@map("site_members")
}

model SiteProject {
  id             Int      @id @default(autoincrement())
  title          String
  subtitle       String   @default("")
  chapter        String   @default("Ramo")
  imageUrl       String   @default("") @map("image_url")
  linkUrl        String   @default("") @map("link_url")
  driveFolderUrl String   @default("") @map("drive_folder_url")
  galleryImages  Json     @default("[]") @map("gallery_images")
  isPublic       Boolean  @default(true) @map("is_public")
  position       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([isPublic, position, title], map: "idx_site_projects_public_order")
  @@map("site_projects")
}

model SiteHomePhoto {
  id             Int      @id @default(autoincrement())
  title          String   @default("")
  imageUrl       String   @map("image_url")
  photoPositionX Int      @default(50) @map("photo_position_x")
  photoPositionY Int      @default(50) @map("photo_position_y")
  photoZoom      Int      @default(100) @map("photo_zoom")
  isPublic       Boolean  @default(true) @map("is_public")
  position       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([isPublic, position, id], map: "idx_site_home_photos_public_order")
  @@map("site_home_photos")
}

model MemberContact {
  id               Int       @id @default(autoincrement())
  name             String
  email            String    @unique
  chapters         Json      @default("[]")
  ieeeMemberNumber String?   @unique @map("ieee_member_number")
  source           String    @default("ieee_member_detail_view")
  userId           Int?      @unique @map("user_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  user             User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([source], map: "idx_member_contacts_source")
  @@map("member_contacts")
}

model Ata {
  id          Int             @id @default(autoincrement())
  userId      Int             @map("user_id")
  title       String
  sociedade   String
  outputName  String          @map("output_name")
  payloadJson String          @map("payload_json")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments AtaAttachment[]

  @@index([sociedade, updatedAt], map: "idx_atas_sociedade_updated")
  @@index([userId, updatedAt], map: "idx_atas_user_updated")
  @@map("atas")
}

model AtaAttachment {
  id       Int    @id @default(autoincrement())
  ataId    Int    @map("ata_id")
  clientId String @map("client_id")
  legenda  String
  fileName String @map("file_name")
  mimeType String @map("mime_type")
  size     Int    @default(0)
  position Int    @default(0)
  ata      Ata    @relation(fields: [ataId], references: [id], onDelete: Cascade)

  @@index([ataId, position], map: "idx_attachments_ata_position")
  @@map("ata_attachments")
}

model InternalFile {
  id           Int      @id @default(autoincrement())
  ownerId      Int      @map("owner_id")
  originalName String   @map("original_name")
  storedName   String   @unique @map("stored_name")
  storageKey   String   @unique @map("storage_key")
  mimeType     String   @default("application/octet-stream") @map("mime_type")
  extension    String   @default("")
  category     String   @default("other")
  size         Int      @default(0)
  checksum     String   @default("")
  description  String   @default("")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  owner        User     @relation("InternalFileOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt], map: "idx_internal_files_owner_created")
  @@map("internal_files")
}

model InternalTask {
  id           Int      @id @default(autoincrement())
  title        String
  description  String   @default("")
  chapter      String
  status       String   @default("pending")
  priority     String   @default("normal")
  dueDate      DateTime? @map("due_date")
  createdById  Int      @map("created_by_id")
  assignedToId Int?     @map("assigned_to_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  assignedTo   User?    @relation("InternalTaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy    User     @relation("InternalTaskCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([chapter, status, dueDate], map: "idx_internal_tasks_chapter_status_due")
  @@index([assignedToId, status], map: "idx_internal_tasks_assignee_status")
  @@map("internal_tasks")
}

model InternalEvent {
  id                  Int      @id @default(autoincrement())
  title               String
  description         String   @default("")
  location            String   @default("")
  chapter             String
  startTime           DateTime @map("start_time")
  endTime             DateTime @map("end_time")
  recurrenceSeriesId  String?  @map("recurrence_series_id")
  recurrenceFrequency String?  @map("recurrence_frequency")
  recurrenceIndex     Int?     @map("recurrence_index")
  recurrenceCount     Int?     @map("recurrence_count")
  createdById         Int      @map("created_by_id")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  createdBy           User     @relation("InternalEventCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([chapter, startTime], map: "idx_internal_events_chapter_start")
  @@index([recurrenceSeriesId], map: "idx_internal_events_recurrence_series")
  @@map("internal_events")
}
